# ===========================================
# EzyMail - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ─── PostgreSQL Database ───
# Use a free Neon, Supabase, or Vercel Postgres connection string
# Example Neon: postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ezymail"

# ─── JWT Secret (REQUIRED) ───
# REQUIRED — authentication fails closed without it. There is no fallback.
# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ─── Vercel Cron Secret (REQUIRED for cron endpoints) ───
# REQUIRED for /api/cron/* — the trial-expiry endpoint rejects every request
# without a valid `Authorization: Bearer <CRON_SECRET>` header. When this is
# set on the Vercel project, Vercel Cron automatically attaches the header to
# scheduled invocations. There is no fallback; unset = all callers rejected.
CRON_SECRET=""

# ─── Firebase Cloud Messaging (Push Notifications) ───
# REQUIRED for web push. The BROWSER-side VAPID key is compiled from this
# NEXT_PUBLIC variable (see src/components/push-notification-setup.tsx);
# the SERVER-side auth uses the full service-account JSON below.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# REQUIRED for server-side push delivery. F-33: the example used to document
# FIREBASE_SERVER_KEY / FIREBASE_VAPID_PRIVATE_KEY — neither is read by the
# code. The server requires exactly this variable: a JSON service-account
# (or a JSON-encoded string of one) with FCM messaging scope. If it is
# missing, push delivery is skipped and every skip is logged
# ([Push] / [PushDispatch] lines in the server logs — grep for
# "sender-env-missing").
# Example shape: {"type":"service_account","project_id":"...", ...}
FIREBASE_SERVICE_ACCOUNT_KEY=""

# NOTE: the Firebase CLIENT config (apiKey/authDomain/projectId/...) is
# hardcoded in src/lib/firebase.ts and is intentionally NOT read from env —
# the six NEXT_PUBLIC_FIREBASE_API_KEY / _AUTH_DOMAIN / _PROJECT_ID /
# _STORAGE_BUCKET / _MESSAGING_SENDER_ID / _APP_ID variables were removed
# from this example (audit F-33) because nothing consumes them.
