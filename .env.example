# ===========================================
# EzyMail - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ─── PostgreSQL Database ───
# Use a free Neon, Supabase, or Vercel Postgres connection string
# Example Neon: postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ezymail"

# ─── JWT Secret (REQUIRED) ───
# REQUIRED — authentication fails closed without it. There is no fallback.
# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ─── Vercel Cron Secret (REQUIRED for cron endpoints) ───
# REQUIRED for /api/cron/* — the trial-expiry endpoint rejects every request
# without a valid `Authorization: Bearer <CRON_SECRET>` header. When this is
# set on the Vercel project, Vercel Cron automatically attaches the header to
# scheduled invocations. There is no fallback; unset = all callers rejected.
CRON_SECRET=""

# ─── Firebase Cloud Messaging (Push Notifications) ───
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_SERVER_KEY=""
FIREBASE_VAPID_PRIVATE_KEY=""
