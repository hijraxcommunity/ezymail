generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  displayName   String?
  bio           String   @default("")
  dateOfBirth   String
  phone         String?
  avatar        String?
  recoveryEmail String?
  role          String   @default("user")
  status        String   @default("active")
  signature     String   @default("")
  preferences   String   @default("{}")
  onboardingDone Boolean @default(false)
  lastLogin     DateTime?
  lastIp        String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Business fields (nullable — personal users unaffected)
  accountType         String   @default("personal")  // "personal" | "business"
  businessName        String?
  businessEmail       String?  @unique
  employeeCount       String?
  subscriptionStatus  String?  // "pending_verification" | "trial" | "active" | "expired"
  trialStart          DateTime?
  trialEnd            DateTime?
  softDeletedAt       DateTime?
  emailReservedUntil  DateTime?

  sentEmails    Email[]  @relation("SentEmails")
  receivedEmails Email[] @relation("ReceivedEmails")
  folders       Folder[]
  labels        Label[]
  contacts      Contact[] @relation("ContactOwner")
  templates     Template[]
  rules         Rule[]
  sessions      Session[]
  twoFactor     TwoFactor[]
  adminLogs     AdminLog[] @relation("AdminLogs")
  reports       Report[]
  loginLogs     LoginLog[]
  pushSubscriptions PushSubscription[]

  // Business relations
  businessVerification BusinessVerification?
  verificationReviews BusinessVerification[] @relation("VerificationReviewer")
  teamMembersOwned    TeamMember[]
  teamMemberships     TeamMember[]  @relation("TeamBusiness")
  customers           Customer[]
  campaigns           Campaign[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([accountType])
  @@index([subscriptionStatus])
  @@index([businessEmail])
  // Phone numbers are verified via WhatsApp OTP before an account is created;
  // the unique constraint is the database-level guarantee that two accounts
  // can never claim the same number (NULLs are allowed — phone is optional).
  @@unique([phone])
}

model Email {
  id              String   @id @default(cuid())
  senderId        String
  recipientEmail  String
  cc              String?
  bcc             String?
  subject         String
  body            String   @default("")
  bodyHtml        String   @default("")
  attachments     String?
  isRead          Boolean  @default(false)
  isStarred       Boolean  @default(false)
  isArchived      Boolean  @default(false)
  folder          String   @default("inbox")
  // Set when a row moves to Trash: the folder the row was moved FROM
  // ("inbox"/"sent"/"drafts"/"spam"/a custom folder name). Restore returns
  // the row to this folder (literal undo of the delete), and the Trash view
  // + lifecycle scope use it to tell the user's OWN trashed sent copies and
  // drafts apart from rows OTHER users trashed in their own mailboxes.
  // Null = row is not in trash, or was trashed before the marker existed.
  trashedFrom     String?
  threadId        String?
  parentEmailId   String?
  readAt          DateTime?
  snoozedUntil    DateTime?
  scheduledAt     DateTime?
  sentAt          DateTime?
  isDraft         Boolean  @default(false)
  priority        String   @default("normal")
  createdAt       DateTime @default(now())

  sender          User     @relation("SentEmails", fields: [senderId], references: [id])
  recipient       User     @relation("ReceivedEmails", fields: [recipientEmail], references: [email])
  replies         Email[]  @relation("EmailReplies")
  parentEmail     Email?   @relation("EmailReplies", fields: [parentEmailId], references: [id])
  reports         Report[]
  emailLabels     EmailLabel[]

  @@index([senderId])
  @@index([recipientEmail])
  @@index([folder])
  @@index([isRead])
  @@index([isStarred])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([parentEmailId])
  @@index([threadId])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#4285F4")
  icon      String   @default("folder")
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderHierarchy")

  @@index([userId])
  @@index([parentId])
}

model Label {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#4285F4")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailLabels EmailLabel[]

  @@index([userId])
}

model EmailLabel {
  id        String   @id @default(cuid())
  emailId   String
  labelId   String
  createdAt DateTime @default(now())

  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([emailId, labelId])
  @@index([emailId])
  @@index([labelId])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String
  phone     String?
  notes     String   @default("")
  isFavorite Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("ContactOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
}

model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String   @default("")
  body      String   @default("")
  bodyHtml  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Rule {
  id          String   @id @default(cuid())
  userId      String
  name        String
  conditions  String
  actions     String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isEnabled])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceName String?
  deviceType String?
  ipAddress  String
  userAgent  String?
  location   String?
  lastActive DateTime @default(now())
  expiresAt  DateTime
  isActive   Boolean @default(true)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, isActive])
}

model TwoFactor {
  id            String   @id @default(cuid())
  userId        String
  secret        String
  isEnabled     Boolean  @default(false)
  backupCodes   String   @default("[]")
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  email     String
  ipAddress String
  userAgent String?
  deviceType String?
  location  String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  emailId     String
  reason      String
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([status])
}

model AdminLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String?
  targetId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  admin       User     @relation("AdminLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  fcmToken   String   @unique
  deviceInfo String?
  platform   String?   // "web", "android", "ios"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
}

model SystemSettings {
  id          String   @id @default(cuid())
  settingKey  String   @unique
  settingValue String?
  category    String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ─── Business Models (Add-Only) ──────────────────────────────────────────────

model BusinessVerification {
  id           String    @id @default(cuid())
  userId       String    @unique
  documentUrls String    // JSON array of URLs
  status       String    @default("pending")  // "pending" | "approved" | "rejected"
  adminNotes   String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser User?   @relation("VerificationReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([submittedAt])
}

model TeamMember {
  id          String    @id @default(cuid())
  businessId  String
  memberEmail String
  role        String    @default("member")  // "admin" | "member"
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?

  business    User      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  teamBusiness User?    @relation("TeamBusiness", fields: [memberEmail], references: [email])

  @@unique([businessId, memberEmail])
  @@index([businessId])
  @@index([memberEmail])
}

model Customer {
  id           String   @id @default(cuid())
  businessId   String
  email        String
  name         String?
  customFields String?  // JSON
  createdAt    DateTime @default(now())

  business     User      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignRecipients CampaignRecipient[]

  @@unique([businessId, email])
  @@index([businessId])
}

model Campaign {
  id           String   @id @default(cuid())
  businessId   String
  subject      String
  body         String   @default("")
  bodyHtml     String   @default("")
  // D1 (Batch 9): honest campaign lifecycle without a delivery provider.
  // "draft"    — being composed; fully editable (content + recipients).
  // "scheduled"— the owner recorded a dispatch intent (scheduledFor).
  //              Nothing is delivered: no outbound transport exists yet, so
  //              a scheduled campaign waits (and says so in the UI) instead
  //              of pretending to run. "sent" is intentionally NOT a state
  //              this schema can produce today; sentAt stays null until a
  //              real provider ships and writes it.
  status       String   @default("draft") // "draft" | "scheduled" | "sent"
  scheduledFor DateTime?
  sentAt       DateTime?
  opens        Int       @default(0)
  clicks       Int       @default(0)
  createdAt    DateTime  @default(now())

  business     User      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients   CampaignRecipient[]

  @@index([businessId])
  @@index([createdAt])
  @@index([status])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  customerId  String
  openedAt    DateTime?
  clickedAt   DateTime?

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
}

// ─── Shared server state (D4, Batch 9) ───────────────────────────────────────
// The OTP challenges, rate-limit windows, single-use token guards and small
// key/value states that used to live in per-instance in-memory Maps now live
// in PostgreSQL (via Prisma). On serverless the old maps were per Lambda
// instance: an OTP minted on instance A could be unverifiable on instance B
// (audit S-02) and every brute-force cap reset on cold start or scaled out
// to a per-instance cap. These tables are the shared, crash-safe source of
// truth; every operation below them is an atomic conditional write (see
// src/lib/server-state.ts). Additive-only migration; cleanup deletes expired
// rows opportunistically.

model OtpChallenge {
  id         String    @id @default(cuid())
  // Purpose-scoped so a code minted for one flow can never verify in another:
  // "phone-verify" (registration + profile phone change) | "password-recovery".
  purpose    String
  // The challenge subject: the E.164 phone number or the user id.
  subject    String
  // sha256(salt) of the 6-digit code — the plaintext code is never stored.
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  // One active challenge per (purpose, subject): a fresh send REPLACES the
  // previous one (upsert), so old codes die the moment a new one is minted.
  @@unique([purpose, subject])
  @@index([expiresAt])
}

model RateBucket {
  // Fixed-window counter, e.g. "login:1.2.3.4", "rule-run:<userId>",
  // "phone-send:+93700123456", "verify-ip:5.6.7.8", "forgot:9.9.9.9".
  key       String   @id
  count     Int      @default(0)
  // End of the current window. A request past windowEnd resets the bucket.
  windowEnd DateTime

  @@index([windowEnd])
}

model UsedTokenGuard {
  // sha256 of a single-use bearer artifact (phone-verification proof token,
  // password-reset token). First insert wins — the unique primary key is the
  // concurrency-safe replay guard; a second consume is a P2002 and rejected.
  tokenHash String   @id
  // Kept at most as long as the artifact's own TTL (+ margin); expired rows
  // are garbage the cleanup removes — they can never verify again anyway
  // because the underlying JWT is expired by then.
  expiresAt DateTime

  @@index([expiresAt])
}

model KvState {
  // Small durable key/value states: phone resend cooldown ("phone-cooldown:
  // <e164>" → last-send epoch ms) and the TOTP single-use last-consumed
  // time-step per user ("totp-step:<userId>").
  key       String    @id
  value     String
  // Null = no TTL (TOTP steps); set = lazy-cleanup deadline.
  expiresAt DateTime?

  @@index([expiresAt])
}
