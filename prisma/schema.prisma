generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminLog {
  id         String   @id
  adminId    String
  action     String
  targetType String?
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
}

model Business {
  id                 String           @id
  ownerId            String
  name               String
  slug               String           @unique
  email              String?
  phone              String?
  website            String?
  address            String?
  industry           String?
  employeeCount      Int?
  logo               String?
  subscriptionStatus String           @default("trial")
  trialStart         DateTime?
  trialEnd           DateTime?
  subscriptionEnd    DateTime?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  User               User             @relation(fields: [ownerId], references: [id])
  BusinessMember     BusinessMember[]
  Campaign           Campaign[]
  Customer           Customer[]

  @@index([isActive])
  @@index([ownerId])
  @@index([slug])
}

model BusinessMember {
  id         String   @id
  businessId String
  userId     String
  role       String   @default("member")
  jobTitle   String?
  department String?
  joinedAt   DateTime @default(now())
  isActive   Boolean  @default(true)
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Campaign {
  id             String    @id
  subject        String
  status         String    @default("draft")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  clickCount     Int       @default(0)
  name           String
  openCount      Int       @default(0)
  bodyHtml       String    @default("")
  businessId     String
  recipientCount Int       @default(0)
  scheduledAt    DateTime?
  sentAt         DateTime?
  Business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model Contact {
  id         String   @id
  userId     String
  name       String
  email      String
  phone      String?
  notes      String   @default("")
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([email])
  @@index([userId])
}

model Customer {
  id         String   @id
  businessId String
  name       String
  email      String
  phone      String?
  company    String?
  notes      String   @default("")
  tags       String   @default("[]")
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
}

model Email {
  id                              String       @id
  senderId                        String
  recipientEmail                  String
  subject                         String
  body                            String       @default("")
  bodyHtml                        String       @default("")
  attachments                     String?
  isRead                          Boolean      @default(false)
  isStarred                       Boolean      @default(false)
  isArchived                      Boolean      @default(false)
  folder                          String       @default("inbox")
  parentEmailId                   String?
  readAt                          DateTime?
  snoozedUntil                    DateTime?
  scheduledAt                     DateTime?
  sentAt                          DateTime?
  isDraft                         Boolean      @default(false)
  priority                        String       @default("normal")
  createdAt                       DateTime     @default(now())
  bcc                             String?
  cc                              String?
  Email                           Email?       @relation("EmailToEmail", fields: [parentEmailId], references: [id])
  other_Email                     Email[]      @relation("EmailToEmail")
  User_Email_recipientEmailToUser User         @relation("Email_recipientEmailToUser", fields: [recipientEmail], references: [email])
  User_Email_senderIdToUser       User         @relation("Email_senderIdToUser", fields: [senderId], references: [id])
  EmailLabel                      EmailLabel[]
  Report                          Report[]

  @@index([createdAt])
  @@index([folder])
  @@index([isRead])
  @@index([isStarred])
  @@index([parentEmailId])
  @@index([recipientEmail])
  @@index([scheduledAt])
  @@index([senderId])
}

model EmailLabel {
  id        String   @id
  emailId   String
  labelId   String
  createdAt DateTime @default(now())
  Email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  Label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([emailId, labelId])
  @@index([emailId])
  @@index([labelId])
}

model Folder {
  id           String   @id
  userId       String
  name         String
  color        String   @default("#4285F4")
  icon         String   @default("folder")
  parentId     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  Folder       Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  other_Folder Folder[] @relation("FolderToFolder")
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([userId])
}

model Label {
  id         String       @id
  userId     String
  name       String
  color      String       @default("#4285F4")
  createdAt  DateTime     @default(now())
  EmailLabel EmailLabel[]
  User       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginLog {
  id         String   @id
  userId     String
  email      String
  ipAddress  String
  userAgent  String?
  deviceType String?
  location   String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([email])
  @@index([userId])
}

model PasswordReset {
  id        String   @id
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [email], references: [email])

  @@index([email])
  @@index([token])
}

model PushSubscription {
  id         String   @id
  userId     String
  fcmToken   String   @unique
  deviceInfo String?
  platform   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fcmToken])
  @@index([userId])
}

model Report {
  id          String    @id
  reporterId  String
  emailId     String
  reason      String
  description String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  Email       Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Rule {
  id         String   @id
  userId     String
  name       String
  conditions String
  actions    String
  isEnabled  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
  @@index([userId])
}

model Session {
  id         String   @id
  userId     String
  token      String   @unique
  deviceName String?
  deviceType String?
  ipAddress  String
  userAgent  String?
  location   String?
  lastActive DateTime @default(now())
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, isActive])
}

model SystemSettings {
  id           String   @id
  settingKey   String   @unique
  settingValue String?
  category     String?
  updatedBy    String?
  updatedAt    DateTime

  @@index([category])
}

model Template {
  id        String   @id
  userId    String
  name      String
  subject   String   @default("")
  body      String   @default("")
  bodyHtml  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TwoFactor {
  id          String    @id
  userId      String
  secret      String
  isEnabled   Boolean   @default(false)
  backupCodes String    @default("[]")
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                               String             @id
  email                            String             @unique
  passwordHash                     String
  firstName                        String
  lastName                         String
  displayName                      String?
  bio                              String             @default("")
  dateOfBirth                      String
  phone                            String?
  avatar                           String?
  recoveryEmail                    String?
  role                             String             @default("user")
  status                           String             @default("active")
  signature                        String             @default("")
  preferences                      String             @default("{}")
  onboardingDone                   Boolean            @default(false)
  lastLogin                        DateTime?
  lastIp                           String?
  deletedAt                        DateTime?
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime
  accountType                      String             @default("personal")
  businessName                     String?
  AdminLog                         AdminLog[]
  Business                         Business[]
  BusinessMember                   BusinessMember[]
  Contact                          Contact[]
  Email_Email_recipientEmailToUser Email[]            @relation("Email_recipientEmailToUser")
  Email_Email_senderIdToUser       Email[]            @relation("Email_senderIdToUser")
  Folder                           Folder[]
  Label                            Label[]
  LoginLog                         LoginLog[]
  PasswordReset                    PasswordReset[]
  PushSubscription                 PushSubscription[]
  Report                           Report[]
  Rule                             Rule[]
  Session                          Session[]
  Template                         Template[]
  TwoFactor                        TwoFactor[]

  @@index([createdAt])
  @@index([email])
  @@index([status])
}
